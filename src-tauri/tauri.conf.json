{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EquiShot",
  "mainBinaryName": "EquiShot",
  "version": "0.23.0",
  "identifier": "fr.equinox.equishot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost asset: http://asset.localhost",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCODc5OUIxNEUyMkNGMTYKUldRV3p5Sk9zWm1IbXhudjNEdnFCQjQwekNRUWwvNGFreFV1c25EWXBrRnhIYlhHWVRTV1dGZTUK",
      "endpoints": [
        "https://www.equinox-ai.fr/equishot/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
